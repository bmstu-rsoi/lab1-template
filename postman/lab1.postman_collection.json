      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Validation error has the documented structure', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.be.a('string');",
              "    pm.expect(body.errors).to.be.an('object');",
              "    pm.expect(body.errors.name).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
