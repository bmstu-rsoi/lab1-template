{
  "info": {
    "name": "Person Service - Lab 1",
    "description": "API tests for Person Service according to person-service.yaml",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - List persons",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/persons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is a JSON array', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Create person",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ivan Ivanov\",\n  \"age\": 30,\n  \"address\": \"Moscow\",\n  \"work\": \"Engineer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/persons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response body is empty', function () { pm.expect(pm.response.text()).to.eql(''); });",
              "pm.test('Location header contains created person ID', function () {",
              "    const location = pm.response.headers.get('Location');",
              "    pm.expect(location).to.be.a('string');",
              "    pm.expect(location).to.match(/\\/api\\/v1\\/persons\\/\\d+$/);",
              "    const id = location.match(/\\d+$/)[0];",
              "    pm.environment.set('personId', id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Get created person",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/persons/{{personId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Person fields are correct', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.eql(Number(pm.environment.get('personId')));",
              "    pm.expect(body.name).to.eql('Ivan Ivanov');",
              "    pm.expect(body.age).to.eql(30);",
              "    pm.expect(body.address).to.eql('Moscow');",
              "    pm.expect(body.work).to.eql('Engineer');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH - Update person",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ivan Petrov\",\n  \"age\": 31\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/persons/{{personId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Changed fields are updated and omitted fields are preserved', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.name).to.eql('Ivan Petrov');",
              "    pm.expect(body.age).to.eql(31);",
              "    pm.expect(body.address).to.eql('Moscow');",
              "    pm.expect(body.work).to.eql('Engineer');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH - Reject missing required name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 32\n}",
          "options": {
